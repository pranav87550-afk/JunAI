<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="← BACK"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/rounded_dark_button"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reminder"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <View
            android:layout_width="80dp"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <!-- Red Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="#E53935"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Reminder Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reminder Title"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="10dp"/>

            <!-- Input box - no red border -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/input_background"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_edit"
                    android:layout_marginEnd="10dp"/>

                <EditText
                    android:id="@+id/reminderTitle"
                    style="@style/WhiteHintEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Ex. Drink water"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:inputType="text"/>

            </LinearLayout>

            <!-- Select Time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Time"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="10dp"/>

            <!-- Time Picker Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/settings_group_card"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <!-- Header: Red clock + Set Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_clock_red"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Set Time"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Type in time"
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:paddingBottom="12dp"/>

                <!-- Hour : Minute : AM/PM -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <!-- Hour picker -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="@drawable/settings_button">

                            <TextView
                                android:id="@+id/hourDisplay"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="12"
                                android:textColor="#FFFFFF"
                                android:textSize="30sp"
                                android:textStyle="bold"
                                android:gravity="center"/>

                            <LinearLayout
                                android:layout_width="28dp"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center">

                                <Button
                                    android:id="@+id/hourUp"
                                    android:layout_width="26dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:text="▲"
                                    android:textColor="#FFFFFF"
                                    android:textSize="10sp"
                                    android:background="@null"
                                    android:padding="0dp"/>

                                <Button
                                    android:id="@+id/hourDown"
                                    android:layout_width="26dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:text="▼"
                                    android:textColor="#FFFFFF"
                                    android:textSize="10sp"
                                    android:background="@null"
                                    android:padding="0dp"/>

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hour"
                            android:textColor="#888888"
                            android:textSize="12sp"
                            android:paddingTop="4dp"/>

                    </LinearLayout>

                    <!-- Colon -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" : "
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:paddingBottom="18dp"/>

                    <!-- Minute picker -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="72dp"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="@drawable/settings_button">

                            <TextView
                                android:id="@+id/minuteDisplay"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="00"
                                android:textColor="#FFFFFF"
                                android:textSize="30sp"
                                android:textStyle="bold"
                                android:gravity="center"/>

                            <LinearLayout
                                android:layout_width="28dp"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center">

                                <Button
                                    android:id="@+id/minuteUp"
                                    android:layout_width="26dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:text="▲"
                                    android:textColor="#FFFFFF"
                                    android:textSize="10sp"
                                    android:background="@null"
                                    android:padding="0dp"/>

                                <Button
                                    android:id="@+id/minuteDown"
                                    android:layout_width="26dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:text="▼"
                                    android:textColor="#FFFFFF"
                                    android:textSize="10sp"
                                    android:background="@null"
                                    android:padding="0dp"/>

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Minute"
                            android:textColor="#888888"
                            android:textSize="12sp"
                            android:paddingTop="4dp"/>

                    </LinearLayout>

                    <!-- AM/PM -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingBottom="18dp">

                        <LinearLayout
                            android:layout_width="80dp"
                            android:layout_height="72dp"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:background="@drawable/settings_button">

                            <TextView
                                android:id="@+id/amPmDisplay"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="PM"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:gravity="center"/>

                            <TextView
                                android:id="@+id/amPmToggle"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:text="▼"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:gravity="center"
                                android:layout_marginEnd="4dp"/>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Quick Select row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/settings_button"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_clock_red"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Quick Select"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <Button
                        android:id="@+id/quick15"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="+15m"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:background="@drawable/rounded_dark_button"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:layout_marginStart="4dp"/>

                    <Button
                        android:id="@+id/quick30"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="+30m"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:background="@drawable/rounded_dark_button"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:layout_marginStart="4dp"/>

                    <Button
                        android:id="@+id/quick1h"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="+1h"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:background="@drawable/rounded_dark_button"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:layout_marginStart="4dp"/>

                    <Button
                        android:id="@+id/quick2h"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="+2h"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:background="@drawable/rounded_dark_button"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:layout_marginStart="4dp"/>

                </LinearLayout>

            </LinearLayout>

            <!-- SET REMINDER Button -->
            <LinearLayout
                android:id="@+id/setReminderButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/settings_button_red"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_delete"
                    android:colorFilter="#FFFFFF"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SET REMINDER"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>

            </LinearLayout>

            <!-- Active Reminders -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Reminders"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="10dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/remindersRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
                        
