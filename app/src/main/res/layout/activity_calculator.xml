<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="bottom"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/expressionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#888888"
            android:textSize="22sp"
            android:gravity="end"/>

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            android:gravity="end"/>

    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="24dp">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button android:id="@+id/btnAC" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="12dp" android:text="AC" android:textColor="#FFFFFF" android:textSize="20sp" android:background="@drawable/calc_button_dark"/>
            <Button android:id="@+id/btnPercent" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="12dp" android:text="%" android:textColor="#FFFFFF" android:textSize="20sp" android:background="@drawable/calc_button_dark"/>
            <Button android:id="@+id/btnDel" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="12dp" android:text="⌫" android:textColor="#FFFFFF" android:textSize="20sp" android:background="@drawable/calc_button_dark"/>
            <Button android:id="@+id/btnDiv" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="÷" android:textColor="#FFFFFF" android:textSize="24sp" android:background="@drawable/calc_button_dark"/>

        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="12dp" android:text="7" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray"/>
            <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="12dp" android:text="8" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray"/>
            <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="12dp" android:text="9" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray"/>
            <Button android:id="@+id/btnMul" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="×" android:textColor="#FFFFFF" android:textSize="24sp" android:background="@drawable/calc_button_dark"/>

        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="12dp" android:text="4" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray"/>
            <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="12dp" android:text="5" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray"/>
            <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="12dp" android:text="6" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray"/>
            <Button android:id="@+id/btnSub" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="−" android:textColor="#FFFFFF" android:textSize="24sp" android:background="@drawable/calc_button_dark"/>

        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="12dp" android:text="1" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray"/>
            <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="12dp" android:text="2" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray"/>
            <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="12dp" android:text="3" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray"/>
            <Button android:id="@+id/btnAdd" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="+" android:textColor="#FFFFFF" android:textSize="24sp" android:background="@drawable/calc_button_dark"/>

        </LinearLayout>

        <!-- Row 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/btn00" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="12dp" android:text="00" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray"/>
            <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="12dp" android:text="0" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray"/>
            <Button android:id="@+id/btnDot" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="12dp" android:text="." android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray"/>
            <Button android:id="@+id/btnEquals" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:text="=" android:textColor="#FFFFFF" android:textSize="24sp" android:background="@drawable/calc_button_red"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
