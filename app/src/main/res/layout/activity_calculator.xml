<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:background="#0A0A0A">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="← BACK"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/rounded_dark_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Calculator"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold|italic"
            android:gravity="center"/>

        <View
            android:layout_width="70dp"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <!-- Red Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="#E53935"/>

    <!-- Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="bottom"
        android:background="#0A0A0A"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/expressionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#666666"
            android:textSize="22sp"
            android:gravity="end"
            android:maxLines="2"
            android:ellipsize="start"/>

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="68sp"
            android:textStyle="bold"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="start"/>

    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="20dp"
        android:background="#0A0A0A">

        <!-- Row 1: AC % ⌫ ÷ -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
            <Button android:id="@+id/btnAC"      android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:text="AC"  android:textColor="#E53935" android:textSize="22sp" android:textStyle="bold" android:background="@drawable/calc_button_dark" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btnPercent" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:text="%"   android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_dark" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btnDel"     android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:text="⌫"   android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_dark" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btnDiv"     android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1"                                 android:text="÷"   android:textColor="#FFFFFF" android:textSize="26sp" android:background="@drawable/calc_button_dark" android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Row 2: 7 8 9 × -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
            <Button android:id="@+id/btn7"   android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:text="7" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btn8"   android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:text="8" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btn9"   android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:text="9" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btnMul" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1"                                 android:text="×" android:textColor="#FFFFFF" android:textSize="26sp" android:background="@drawable/calc_button_dark" android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Row 3: 4 5 6 − -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
            <Button android:id="@+id/btn4"   android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:text="4" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btn5"   android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:text="5" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btn6"   android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:text="6" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btnSub" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1"                                 android:text="−" android:textColor="#FFFFFF" android:textSize="26sp" android:background="@drawable/calc_button_dark" android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Row 4: 1 2 3 + -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="10dp">
            <Button android:id="@+id/btn1"   android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:text="1" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btn2"   android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:text="2" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btn3"   android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:text="3" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btnAdd" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1"                                 android:text="+" android:textColor="#FFFFFF" android:textSize="26sp" android:background="@drawable/calc_button_dark" android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Row 5: 00 0 . = -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btn00"     android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:text="00" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btn0"      android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:text="0"  android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_button_gray" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btnDot"    android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:text="."  android:textColor="#FFFFFF" android:textSize="26sp" android:background="@drawable/calc_button_gray" android:stateListAnimator="@null"/>
            <Button android:id="@+id/btnEquals" android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1"                                 android:text="="  android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:background="@drawable/calc_button_red" android:stateListAnimator="@null"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
