<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="← BACK"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/rounded_dark_button"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Data Management"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"/>

        <View
            android:layout_width="80dp"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <!-- Red divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="#E53935"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── Knowledge Count Section ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_menu_learning_nodes"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  Knowledge Count"
                    android:textColor="#E53935"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- Knowledge Count Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/settings_group_card"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/knowledgeCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 questions stored"
                        android:textColor="#FFFFFF"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:paddingBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total knowledge in Jun's memory"
                        android:textColor="#888888"
                        android:textSize="13sp"/>

                </LinearLayout>

                <!-- Brain icon on right -->
                <LinearLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:background="@drawable/settings_button">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_menu_archive"/>

                </LinearLayout>

            </LinearLayout>

            <!-- ── File Import Section ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_menu_folder"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  File Import"
                    android:textColor="#E53935"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- File Import Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/settings_group_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <!-- Top row: text + JSON icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Import JSON file with Q&amp;A data"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:paddingBottom="4dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Format: {&quot;question&quot;: &quot;answer&quot;, ...}"
                            android:textColor="#888888"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <!-- JSON file icon -->
                    <LinearLayout
                        android:layout_width="56dp"
                        android:layout_height="64dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginStart="12dp">

                        <!-- Red card shape -->
                        <LinearLayout
                            android:layout_width="48dp"
                            android:layout_height="56dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/settings_button_red">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="{}"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="JSON"
                                android:textColor="#FFFFFF"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.1"/>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Choose File Button -->
                <Button
                    android:id="@+id/importFileButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="CHOOSE JSON FILE"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:drawableStart="@drawable/ic_menu_folder"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:background="@drawable/settings_button_red"/>

            </LinearLayout>

            <!-- Import Result -->
            <TextView
                android:id="@+id/importResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#2E7D32"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="gone"
                android:layout_marginBottom="16dp"/>

            <!-- ── JSON Format Guide Section ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_menu_clipboard"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  JSON Format Guide"
                    android:textColor="#E53935"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- Format Guide Code Block -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text='{\n\n  "what is google": "Google is a search engine",\n\n  "capital of india": "New Delhi",\n\n  "what is ai": "AI is artificial intelligence"\n\n}'
                android:textColor="#E8E8E8"
                android:textSize="13sp"
                android:background="@drawable/settings_group_card"
                android:padding="16dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
