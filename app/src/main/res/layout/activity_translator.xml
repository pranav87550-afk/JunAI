<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:orientation="vertical">

    <!-- Header — red gradient bg, italic bold title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:background="@drawable/translator_header_bg">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="← BACK"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/rounded_dark_button"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Jun Translate"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold|italic"
            android:gravity="center"/>

        <!-- Spacer to balance back button -->
        <View
            android:layout_width="80dp"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <!-- Language Selector Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <!-- Source Language Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:background="@drawable/translator_lang_card">

            <Spinner
                android:id="@+id/sourceLang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FFFFFF"
                android:popupBackground="#1E1E26"/>

        </LinearLayout>

        <!-- Swap Button — red circle -->
        <ImageButton
            android:id="@+id/swapLang"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/translator_swap_btn"
            android:src="@drawable/ic_swap"
            android:padding="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Swap"/>

        <!-- Target Language Card -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:background="@drawable/translator_lang_card">

            <Spinner
                android:id="@+id/targetLang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FFFFFF"
                android:popupBackground="#1E1E26"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Input Box with char counter -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/translator_input_card">

        <EditText
            android:id="@+id/inputText"
            style="@style/WhiteHintEditText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:padding="16dp"
            android:paddingBottom="36dp"
            android:hint="Tap to enter text"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:gravity="top"
            android:inputType="textMultiLine"/>

        <!-- Character counter bottom-right -->
        <TextView
            android:id="@+id/charCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:text="0/5000"
            android:textColor="#666666"
            android:textSize="12sp"/>

    </FrameLayout>

    <!-- TRANSLATE Button — full width, bold italic, arrow -->
    <Button
        android:id="@+id/translateButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:text="TRANSLATE  →"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold|italic"
        android:letterSpacing="0.08"
        android:background="@drawable/translator_translate_btn"/>

    <!-- Output Box -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="12dp"
        android:background="@drawable/translator_input_card">

        <!-- "Translation" label + copy icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Translation"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <ImageButton
                android:id="@+id/copyButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@null"
                android:src="@drawable/ic_copy"
                android:padding="6dp"
                android:contentDescription="Copy"/>

        </LinearLayout>

        <TextView
            android:id="@+id/outputText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="48dp"
            android:paddingBottom="16dp"
            android:text="Translation will appear here..."
            android:textColor="#666666"
            android:textSize="17sp"
            android:textStyle="italic"
            android:gravity="top"/>

    </FrameLayout>

</LinearLayout>
