<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:background="#E53935">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="← Back"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@drawable/rounded_dark_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Jun Translate"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <View
            android:layout_width="70dp"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <!-- Language Selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1E1E26"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <Spinner
            android:id="@+id/sourceLang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:popupBackground="#1E1E26"/>

        <ImageButton
            android:id="@+id/swapLang"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/rounded_dark_button"
            android:src="@drawable/ic_swap"
            android:padding="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Swap"/>

        <Spinner
            android:id="@+id/targetLang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:popupBackground="#1E1E26"/>

    </LinearLayout>

    <!-- Input Box -->
    <EditText
        android:id="@+id/inputText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#111116"
        android:padding="16dp"
        android:hint="Tap to enter text"
        android:hintTextColor="#888888"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:gravity="top"
        android:inputType="textMultiLine"/>

    <!-- Translate Button -->
    <Button
        android:id="@+id/translateButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Translate"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="@drawable/settings_button_red"/>

    <!-- Output Box -->
    <TextView
        android:id="@+id/outputText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E26"
        android:padding="16dp"
        android:text="Translation will appear here..."
        android:textColor="#AAAAAA"
        android:textSize="18sp"
        android:gravity="top"/>

</LinearLayout>
