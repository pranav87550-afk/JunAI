<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/crystal_song_item"
    android:elevation="4dp">

    <!-- Current song red indicator -->
    <View
        android:id="@+id/currentSongIndicator"
        android:layout_width="3dp"
        android:layout_height="36dp"
        android:background="#FF1744"
        android:layout_marginEnd="12dp"
        android:visibility="invisible"/>

    <!-- Song title -->
    <TextView
        android:id="@+id/songItemTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:letterSpacing="0.02"/>

    <!-- Menu button -->
    <ImageButton
        android:id="@+id/songItemMenu"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/crystal_control_button"
        android:src="@drawable/ic_more_vert"
        android:contentDescription="Menu"
        android:padding="8dp"
        android:elevation="2dp"/>

</LinearLayout>
