<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050508">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:background="#0A0A12">

        <LinearLayout
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/crystal_glass_button"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Back"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Manage Learning"
            android:textColor="#1565C0"
            android:textSize="20sp"
            android:textStyle="bold|italic"
            android:gravity="center"
            android:shadowColor="#1565C0"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="10"/>

        <View android:layout_width="70dp" android:layout_height="1dp"/>

    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1.5dp" android:background="#1565C0"/>
    <View android:layout_width="match_parent" android:layout_height="4dp" android:background="#221565C0"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Jun ne jo bhi passively seekha hai, wo yahan dikhega. Kisi bhi app ka seekha hua alag se bhula sakte ho, ya sab kuch ek saath."
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:padding="14dp"/>

    <!-- Forget everything -->
    <LinearLayout
        android:id="@+id/forgetAllButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/crystal_glass_button"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗑️  Sab kuch bhula do"
            android:textColor="#E53935"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Abhi tak kuch nahi seekha — koi app allow karke thoda use karo."
        android:textColor="#66FFFFFF"
        android:textSize="12sp"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appListRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="16dp"/>

</LinearLayout>
