<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:background="#0A0A0F">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="← Back"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@drawable/rounded_dark_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <View
            android:layout_width="70dp"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="#E53935"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Theme"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="8dp"/>

            <Button
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Red-black (default)"
                android:textColor="#FFFFFF"
                android:background="@drawable/settings_button"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voice"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="8dp"/>

            <Button
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Voice: tts"
                android:textColor="#FFFFFF"
                android:background="@drawable/settings_button"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/settings_button"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Voice"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"/>

                <Switch
                    android:id="@+id/voiceSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:showText="true"
                    android:textOn="On"
                    android:textOff="Off"
                    android:textColor="#FFFFFF"
                    android:thumbTint="#E53935"
                    android:trackTint="#4A1010"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Pitch"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"/>

                <SeekBar
                    android:id="@+id/pitchSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progress="50"
                    android:progressTint="#E53935"
                    android:thumbTint="#E53935"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:text="Speed rate"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"/>

                <SeekBar
                    android:id="@+id/speedSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:progress="60"
                    android:progressTint="#E53935"
                    android:thumbTint="#E53935"/>

            </LinearLayout>

            <Button
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Preview voice"
                android:textColor="#FFFFFF"
                android:background="@drawable/settings_button"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="8dp"/>

            <Button
                android:id="@+id/btnClearChat"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Clear chat"
                android:textColor="#FFFFFF"
                android:background="@drawable/settings_button"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnExportChat"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Export chat"
                android:textColor="#FFFFFF"
                android:background="@drawable/settings_button"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Data"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="8dp"/>

            <Button
                android:id="@+id/btnClearNotes"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Clear all notes"
                android:textColor="#FFFFFF"
                android:background="@drawable/settings_button"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnClearTodo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Clear all To-do lists"
                android:textColor="#FFFFFF"
                android:background="@drawable/settings_button"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnClearMemory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Clear all Memory"
                android:textColor="#FFFFFF"
                android:background="@drawable/settings_button"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnClearReminder"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Clear all Reminder"
                android:textColor="#FFFFFF"
                android:background="@drawable/settings_button"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnClearUnanswered"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Clear all unanswered questions"
                android:textColor="#FFFFFF"
                android:background="@drawable/settings_button"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="8dp"/>

            <Button
                android:id="@+id/btnFactoryReset"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="FACTORY RESET"
                android:textColor="#FFFFFF"
                android:background="@drawable/settings_button_red"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnSaveChanges"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Save changes"
                android:textColor="#FFFFFF"
                android:background="@drawable/settings_button_green"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
