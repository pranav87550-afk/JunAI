<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#0A0A0F">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/rounded_dark_button"
            android:src="@drawable/ic_close"
            android:padding="8dp"
            android:contentDescription="Back"/>

        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/undoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/rounded_dark_button"
            android:src="@drawable/ic_undo"
            android:padding="8dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Undo"/>

        <ImageButton
            android:id="@+id/redoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/rounded_dark_button"
            android:src="@drawable/ic_redo"
            android:padding="8dp"
            android:contentDescription="Redo"/>

    </LinearLayout>

    <!-- Canvas -->
    <com.junai.app.DrawingView
        android:id="@+id/drawingView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"/>

    <!-- Bottom Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#111116">

        <ImageButton
            android:id="@+id/addStrokeButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/rounded_dark_button"
            android:src="@drawable/ic_add"
            android:padding="8dp"
            android:contentDescription="Add"/>

        <!-- Colors -->
        <View android:id="@+id/colorRed" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/color_circle_red" android:layout_marginStart="8dp"/>
        <View android:id="@+id/colorOrange" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/color_circle_orange" android:layout_marginStart="8dp"/>
        <View android:id="@+id/colorWhite" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/color_circle_white" android:layout_marginStart="8dp"/>
        <View android:id="@+id/colorBlack" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/color_circle_black" android:layout_marginStart="8dp"/>
        <View android:id="@+id/colorNavy" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/color_circle_navy" android:layout_marginStart="8dp"/>
        <View android:id="@+id/colorBlue" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/color_circle_blue" android:layout_marginStart="8dp"/>
        <View android:id="@+id/colorTeal" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/color_circle_teal" android:layout_marginStart="8dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <ImageButton
            android:id="@+id/eraserButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/rounded_dark_button"
            android:src="@drawable/ic_delete"
            android:padding="8dp"
            android:contentDescription="Eraser"/>

    </LinearLayout>

</LinearLayout>
