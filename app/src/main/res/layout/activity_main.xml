<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0A0A0F">

        <!-- Top Bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:background="#0A0A0F"
            app:layout_constraintTop_toTopOf="parent"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/rounded_dark_button"
                android:src="@drawable/ic_menu"
                android:padding="10dp"
                android:contentDescription="Menu"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jun "
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#E53935"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-medium"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your AI Assistant"
                    android:textSize="12sp"
                    android:textColor="#888888"/>

            </LinearLayout>

            <!-- Network Status Indicator -->
            <LinearLayout
                android:id="@+id/networkStatusLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp">

                <TextView
                    android:id="@+id/networkDot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textSize="14sp"
                    android:textColor="#43A047"
                    android:layout_marginEnd="5dp"/>

                <TextView
                    android:id="@+id/networkStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online"
                    android:textColor="#43A047"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>
        

        <!-- Red Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:background="#E53935"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>

        <!-- Chat Area -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintBottom_toTopOf="@id/bottomBar"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>

        <!-- Speaking Indicator -->
        <LinearLayout
            android:id="@+id/speakingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bubble_jun"
            android:layout_marginStart="16dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/typingIndicator"
            app:layout_constraintStart_toStartOf="parent"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jun is speaking  "
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

            <View
                android:id="@+id/speakDot1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/typing_dot"/>

            <View
                android:id="@+id/speakDot2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/typing_dot"/>

            <View
                android:id="@+id/speakDot3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/typing_dot"/>

        </LinearLayout>
        
        <!-- Typing Indicator -->
        <LinearLayout
            android:id="@+id/typingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bubble_jun"
            android:layout_marginStart="16dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottomBar"
            app:layout_constraintStart_toStartOf="parent"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jun is typing  "
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

            <View
                android:id="@+id/dot1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/typing_dot"/>

            <View
                android:id="@+id/dot2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/typing_dot"/>

            <View
                android:id="@+id/dot3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/typing_dot"/>

        </LinearLayout>

        <!-- Bottom Input Bar -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:background="#0A0A0F"
            app:layout_constraintBottom_toBottomOf="parent"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <ImageButton
                android:id="@+id/micButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/rounded_dark_button"
                android:src="@drawable/ic_mic"
                android:padding="10dp"
                android:contentDescription="Mic"/>

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/input_background"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:hint="Ask to Jun..."
                android:textColorHint="#888888"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:inputType="text"
                android:maxLines="1"/>

            <ImageButton
                android:id="@+id/sendButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/rounded_red_button"
                android:src="@drawable/ic_send"
                android:padding="10dp"
                android:contentDescription="Send"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- DRAWER PANEL -->
<ScrollView
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="#0A0A12"
    android:scrollbarThumbVertical="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="32dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- Jun AI Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/crystal_glass_button"
            android:padding="14dp"
            android:layout_marginBottom="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖"
                android:textSize="28sp"
                android:layout_marginEnd="10dp"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jun AI"
                    android:textColor="#FF1744"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:shadowColor="#FF1744"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="8"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your AI Companion"
                    android:textColor="#88FFFFFF"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- SETTINGS (standalone) -->
        <LinearLayout
            android:id="@+id/menuSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/crystal_menu_item"
            android:padding="12dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:text="⚙️"
                android:textSize="18sp"
                android:gravity="center"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="General app settings"
                    android:textColor="#88FFFFFF"
                    android:textSize="11sp"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#FF1744"
                android:textSize="20sp"/>
        </LinearLayout>

        <!-- CATEGORY: AI & ASSISTANT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/crystal_category_ai"
            android:padding="10dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖"
                    android:textSize="14sp"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI &amp; ASSISTANT"
                    android:textColor="#7B68EE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menuMiniJun"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/crystal_menu_item"
                android:padding="10dp"
                android:layout_marginBottom="6dp">
                <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="🤖" android:textSize="16sp" android:gravity="center"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mini-Jun Settings" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Customize your Mini-Jun" android:textColor="#88FFFFFF" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#7B68EE" android:textSize="18sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menuLearningCenter"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/crystal_menu_item"
                android:padding="10dp"
                android:layout_marginBottom="6dp">
                <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="🎓" android:textSize="16sp" android:gravity="center"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Learning Center" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Teach Jun new things" android:textColor="#88FFFFFF" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#7B68EE" android:textSize="18sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menuNegative"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/crystal_menu_item"
                android:padding="10dp">
                <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="💬" android:textSize="16sp" android:gravity="center"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Response Filters" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Manage negative responses" android:textColor="#88FFFFFF" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#7B68EE" android:textSize="18sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- CATEGORY: PRODUCTIVITY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/crystal_category_productivity"
            android:padding="10dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingBottom="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✂️" android:textSize="14sp" android:layout_marginEnd="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PRODUCTIVITY" android:textColor="#4CAF50" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.1"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/menuNotes" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/crystal_menu_item" android:padding="10dp" android:layout_marginBottom="6dp">
                <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="📝" android:textSize="16sp" android:gravity="center"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Notes" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Write and manage notes" android:textColor="#88FFFFFF" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#4CAF50" android:textSize="18sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/menuTodo" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/crystal_menu_item" android:padding="10dp" android:layout_marginBottom="6dp">
                <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="✅" android:textSize="16sp" android:gravity="center"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="To-Do Lists" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Plan and organize tasks" android:textColor="#88FFFFFF" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#4CAF50" android:textSize="18sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/menuReminder" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/crystal_menu_item" android:padding="10dp" android:layout_marginBottom="6dp">
                <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="⏰" android:textSize="16sp" android:gravity="center"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reminder" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Set reminders and alerts" android:textColor="#88FFFFFF" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#4CAF50" android:textSize="18sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/menuTranslator" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/crystal_menu_item" android:padding="10dp">
                <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="🌐" android:textSize="16sp" android:gravity="center"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Translator" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Translate any language" android:textColor="#88FFFFFF" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#4CAF50" android:textSize="18sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- CATEGORY: TOOLS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/crystal_category_tools"
            android:padding="10dp"
            android:layout_marginBottom="12dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingBottom="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎨" android:textSize="14sp" android:layout_marginEnd="6dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TOOLS" android:textColor="#FF6D00" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.1"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/menuCalculator" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/crystal_menu_item" android:padding="10dp" android:layout_marginBottom="6dp">
                <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="🔢" android:textSize="16sp" android:gravity="center"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Calculator" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Basic calculations" android:textColor="#88FFFFFF" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#FF6D00" android:textSize="18sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/menuDraw" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/crystal_menu_item" android:padding="10dp" android:layout_marginBottom="6dp">
                <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="🎨" android:textSize="16sp" android:gravity="center"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sketch Pad" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Draw and sketch anything" android:textColor="#88FFFFFF" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#FF6D00" android:textSize="18sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/menuSongs" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/crystal_menu_item" android:padding="10dp">
                <TextView android:layout_width="28dp" android:layout_height="wrap_content" android:text="🎵" android:textSize="16sp" android:gravity="center"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Music Player" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Play your favorite songs" android:textColor="#88FFFFFF" android:textSize="10sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#FF6D00" android:textSize="18sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- CATEGORY: SYSTEM -->
        <LinearLayout
            android:layout_width="match_parent"
