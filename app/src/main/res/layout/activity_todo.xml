<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="← Back"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="@drawable/rounded_dark_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="To-do Lists"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <View
            android:layout_width="70dp"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <!-- Red Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="#E53935"/>

    <!-- Add Todo Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <EditText
            android:id="@+id/todoInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/input_background"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Add your new todo"
            android:hintTextColor="#888888"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:inputType="text"
            android:layout_marginEnd="8dp"/>

        <ImageButton
            android:id="@+id/addTodoButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/rounded_red_button"
            android:src="@drawable/ic_add"
            android:padding="10dp"
            android:contentDescription="Add Todo"/>

    </LinearLayout>

    <!-- Todo List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/todoRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:clipToPadding="false"/>

    <!-- Bottom Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#111116">

        <TextView
            android:id="@+id/pendingCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="You have 0 pending tasks"
            android:textColor="#AAAAAA"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/clearAllButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Clear All"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:background="@drawable/rounded_red_button"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>

    </LinearLayout>

</LinearLayout>
