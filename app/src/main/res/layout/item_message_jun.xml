<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="64dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bubble_jun"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/messageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:textColor="#888888"
            android:textSize="11sp"
            android:paddingTop="2dp"/>

    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="start"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/copyButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/rounded_dark_button"
            android:src="@drawable/ic_copy"
            android:padding="6dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Copy"/>

        <ImageButton
            android:id="@+id/speakButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/rounded_dark_button"
            android:src="@drawable/ic_mic"
            android:padding="6dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Speak"/>

        <ImageButton
            android:id="@+id/thumbsUpButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/rounded_dark_button"
            android:src="@drawable/ic_thumbs_up"
            android:padding="6dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Thumbs Up"/>

        <ImageButton
            android:id="@+id/thumbsDownButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/rounded_dark_button"
            android:src="@drawable/ic_thumbs_down"
            android:padding="6dp"
            android:contentDescription="Thumbs Down"/>

    </LinearLayout>

</LinearLayout>
