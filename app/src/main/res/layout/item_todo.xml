<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <!-- Circle checkbox button -->
    <ImageButton
        android:id="@+id/checkCircleButton"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/circle_icon_badge"
        android:src="@null"
        android:layout_marginEnd="12dp"
        android:contentDescription="Mark complete"/>

    <!-- Todo text -->
    <TextView
        android:id="@+id/todoText"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:background="@drawable/todo_item_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginEnd="8dp"/>

    <!-- Delete button -->
    <ImageButton
        android:id="@+id/deleteTodoButton"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/settings_button_red"
        android:src="@drawable/ic_delete"
        android:padding="9dp"
        android:contentDescription="Delete"/>

</LinearLayout>
