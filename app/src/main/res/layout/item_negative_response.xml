<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/settings_button"
        android:padding="12dp">

        <TextView
            android:id="@+id/negativeQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E53935"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingBottom="4dp"/>

        <TextView
            android:id="@+id/negativeAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingBottom="8dp"/>

        <EditText
            android:id="@+id/correctAnswerInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:hint="Type correct answer..."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:inputType="textMultiLine"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/saveCorrectButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Save"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/settings_button_green"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/deleteNegativeButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Delete"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/settings_button_red"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
