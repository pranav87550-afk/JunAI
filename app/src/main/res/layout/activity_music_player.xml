<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050508"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="24dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:background="#0A0A12">

            <Button
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="← Back"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/crystal_glass_button"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Jun DJ"
                android:textColor="#FF1744"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:shadowColor="#FF1744"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="12"/>

            <View
                android:layout_width="70dp"
                android:layout_height="1dp"/>

        </LinearLayout>

        <!-- Neon Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:background="#FF1744"/>

        <!-- Red glow line below divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="#33FF1744"/>

        <!-- Album Art Crystal -->
        <LinearLayout
            android:id="@+id/albumArtLayout"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@drawable/crystal_album_art"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"
            android:elevation="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎵"
                android:textSize="72sp"/>

        </LinearLayout>

        <!-- Song Title -->
        <TextView
            android:id="@+id/songTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Song Title"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="6dp"
            android:shadowColor="#FF1744"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"/>

        <!-- Artist -->
        <TextView
            android:id="@+id/songArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unknown Artist"
            android:textColor="#FF5252"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- SeekBar -->
        <SeekBar
            android:id="@+id/musicSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:progressTint="#FF1744"
            android:progressBackgroundTint="#33FF1744"
            android:thumb="@drawable/crystal_seekbar_thumb"
            android:layout_marginBottom="6dp"/>

        <!-- Time Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/currentTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textColor="#FF5252"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/totalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#FF5252"
                android:textSize="12sp"/>

        </LinearLayout>

        <!-- Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="28dp">

            <ImageButton
                android:id="@+id/prevButton"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/crystal_control_button"
                android:src="@drawable/ic_previous"
                android:padding="14dp"
                android:layout_marginEnd="20dp"
                android:elevation="6dp"
                android:contentDescription="Previous"/>

            <ImageButton
                android:id="@+id/playPauseButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/crystal_play_button"
                android:src="@drawable/ic_pause"
                android:padding="18dp"
                android:layout_marginEnd="20dp"
                android:elevation="10dp"
                android:contentDescription="Play Pause"/>

            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/crystal_control_button"
                android:src="@drawable/ic_next"
                android:padding="14dp"
                android:elevation="6dp"
                android:contentDescription="Next"/>

        </LinearLayout>

        <!-- All Songs Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All Songs"
            android:textColor="#FF1744"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="24dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:shadowColor="#FF1744"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"/>

        <!-- Song List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/songListRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
