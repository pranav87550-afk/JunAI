<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer red glow ring -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:startColor="#99FF1744"
                android:endColor="#00FF1744"
                android:gradientRadius="50%"/>
        </shape>
    </item>
    <!-- Glass base -->
    <item android:top="6dp" android:left="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:startColor="#CCFF1744"
                android:endColor="#88B71C1C"
                android:angle="135"/>
            <stroke android:width="1.5dp" android:color="#FFFF5252"/>
        </shape>
    </item>
    <!-- Glass shine top -->
    <item android:top="8dp" android:left="12dp" android:right="12dp" android:bottom="36dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:startColor="#55FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270"/>
        </shape>
    </item>
</layer-list>
