<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glass dark base -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:startColor="#44FFFFFF"
                android:endColor="#11FFFFFF"
                android:angle="135"/>
            <stroke android:width="1dp" android:color="#44FF5252"/>
        </shape>
    </item>
    <!-- Shine -->
    <item android:bottom="28dp" android:left="8dp" android:right="8dp" android:top="4dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270"/>
        </shape>
    </item>
</layer-list>
